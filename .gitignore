# Google Play service account key (EAS Submit) - never commit
google-service-account*.json
play-store-*.json
pc-api-*.json

# Apple signing keys and certificates - never commit.
# eas.json supports pointing ascApiKeyPath at a .p8 on disk. This project
# keeps its App Store Connect key on EAS instead, but a downloaded key still
# lands in Downloads or the project folder, so guard the patterns.
*.p8
*.p12
*.mobileprovision
*.cer

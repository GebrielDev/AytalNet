{
  "expo": {
    "name": "STS Driver App",
    "slug": "driverapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "us.startechsolutions.driverapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph your odometer, plate and selfie for trip records.",
        "NSLocationWhenInUseUsageDescription": "Records trip routes and confirms arrival at your stops.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "us.startechsolutions.driverapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph your odometer, plate and selfie for trip records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Records trip routes and confirms arrival at your stops."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://api.startechsolutions.us/api",
      "eas": {
        "projectId": "d2207950-fd79-41c3-ba89-efb8931e2a0a"
      }
    }
  }
}

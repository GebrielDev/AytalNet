# Server
PORT=3000
NODE_ENV=development

# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/fleet_management

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Cloudinary (for image uploads - free tier available)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Password reset email.
#
# Resend is used when RESEND_API_KEY is set, over its HTTPS API. Get a key at
# resend.com and verify the sending domain there, or mail will be rejected with
# "The domain is not verified". Left commented out so a copied .env does not
# select Resend with a placeholder key.
# RESEND_API_KEY=re_your_api_key
EMAIL_FROM=STS Fleet <noreply@startechsolutions.us>

# SMTP is the fallback, used only when RESEND_API_KEY is absent. Note that
# Microsoft 365 refuses SMTP client submission at the tenant level by default
# (535 5.7.139), and hosts commonly block outbound SMTP, which is why the API
# above is preferred.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

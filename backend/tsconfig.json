{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // This config builds what ships. Tests are typechecked separately by
  // `npm run typecheck` (tsconfig.typecheck.json), but must not be compiled
  // into dist and deployed.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "vitest.config.ts"]
}
